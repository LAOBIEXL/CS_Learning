{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C++: 编译当前文件",
            "command": "D:\\Forvs\\mingw1120_64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "-fdiagnostics-color=always",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "使用 MinGW g++ 编译当前 C++ 文件"
        },
        {
            "type": "cppbuild",
